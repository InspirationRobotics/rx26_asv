<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_behavior</name>
  <version>0.5.0</version>
  <description>
    What the boat does with its own state: safety/ holds the RC-loss force-
    disarm watchdog, indicator/ holds the LED status stack. Both consume
    crusader_fcu's republished topics; neither opens a MAVLink connection.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>crusader_msgs</depend>
  <depend>crusader_common</depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
