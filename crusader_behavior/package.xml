<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_behavior</name>
  <version>0.6.0</version>
  <description>
    The autopilot gateway (telemetry_bridge, the only node that talks to the Pixhawk), the
    RC-loss force-disarm watchdog and the LED status stack.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rcl_interfaces</depend>
  <depend>crusader_msgs</depend>
  <depend>crusader_common</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
