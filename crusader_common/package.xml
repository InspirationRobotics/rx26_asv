<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_common</name>
  <version>0.5.0</version>
  <description>
    Shared plumbing for every Crusader node: run_node and plain parameter
    declaration, the freshness-gated stream cache, and geodesy. No nodes.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
