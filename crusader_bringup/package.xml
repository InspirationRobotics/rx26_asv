<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_bringup</name>
  <version>0.5.0</version>
  <description>
    How the boat is started: launch files and the single-source-of-truth
    parameter file. Ships no code. Depends on every package it launches, so
    `colcon build --packages-up-to crusader_bringup` builds the whole stack.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>crusader_behavior</exec_depend>
  <!-- core.launch.py runs crusader_perception's lidar_node and camera_node, but not
       crusader_world_model's target_tracker (the Nodes tab starts it). Both are
       exec_depended on anyway: a
       "packages-up-to crusader_bringup" build must cover every package we ship,
       or one silently stops being built and its compile errors surface on the
       boat instead of at build time. -->
  <exec_depend>crusader_perception</exec_depend>
  <exec_depend>crusader_world_model</exec_depend>
  <exec_depend>crusader_groundstation</exec_depend>
  <!-- The behaviour-tree runner and its leaves. Exec_depended for the same
       reason as the rest: a package missing from this list is silently NOT
       BUILT by rebuild.sh's colcon build (packages-up-to crusader_bringup).
       NOTE: no double hyphen anywhere in this comment; XML forbids it. -->
  <exec_depend>crusader_bt</exec_depend>
  <!-- The UAV link. Not in core.launch.py either: it is only useful above Core
       tier, and nothing has carried an RXL frame over a real radio yet. Listed
       for the same reason as the rest, because a package nothing depends on is
       silently not built. -->
  <exec_depend>crusader_link</exec_depend>
  <!-- Nav2 obstacle avoidance (docs/nav2_avoidance_spec.md). Not in
       core.launch.py: nav.launch.py is started by hand until it has run on the
       water. Both build without Nav2 (the layer installs nothing and the
       Python package only needs it to run), so the boat can take them before
       its container is recreated. Listed for the same reason as the rest: a
       package nothing depends on is silently not built. -->
  <exec_depend>crusader_nav</exec_depend>
  <exec_depend>crusader_nav_layers</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
