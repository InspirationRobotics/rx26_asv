<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task3ScanFireOnce: Task3ScanFire (lib/task3_scan_fire.xml) that ENDS. Same body, same numbers;
  the only difference is the fire: Task3ScanFire waits for RED after RED for ever (the run ends
  in the dock), this one puts out ONE fire and then SUCCEEDS, so a mission can go on to another
  task (mission_t3_t4_t1.xml: Task 1 after it). At the competition RoboCommand lights one RED,
  after the docking report (3.3.4).

  Done = docked (docking report sent), our window sprayed until it read GREEN, backed off to
  t3_backoff_m, firefighting report sent, the 2-colour code read and the resource delivery report
  sent. A code not read in 80 s (the 60 s of flashing missed) still ends it: the fire is out and
  nothing more is to be had from Task 3.

  Like Task3ScanFire it has no task token, no guard band and no Task 4 guard: the caller wraps it.
  It writes use_lidar, hold_m, bay, target, window and request on the caller's blackboard
  (_autoremap) and reads t3_backoff_m there (bt_runner_node puts it there at Start).

  Once per run: the caller sets t3_fire_out and t3_request_sent false at its start, OUTSIDE its
  Task 4 guard (a script reading a missing key throws). A restart after a break-off then skips
  what is done: after the fire, no wait for a second RED (RoboCommand lights one) and no second
  firefighting report; after the resource report, no second read of the code either.

    0. camera on the dock model; GUIDED to the approach point (skipped when MANUAL); MANUAL.
    1. slide along the dock to the first bay read GREEN (OFF counts as GREEN).
    2. side by side from GREEN on (Parallel, ends when the fire side is done):
       DOCK: square, centre, push in, hold 1.7 m off the face; docking report the first time
             in close; then keep holding at hold_m.
       FIRE: wait for our bay's window to read RED (re-sending the docking report every 10 s
             until RoboCommand confirms) -> spray until GREEN (a spray that fails waits for the
             RED again) -> hold at t3_backoff_m -> firefighting report -> read the code ->
             resource delivery report -> DONE.
  Keep the ports in step with lib/task3_scan_fire.xml when tuning either.
-->
<root BTCPP_format="4">

  <BehaviorTree ID="Task3ScanFireOnce">
    <Sequence name="scan_fire_once">
      <Script code="use_lidar := false"/>
      <Script code="hold_m := t3_hold_m"/>

      <SetCameraModel model="dock" indicator="yolo" timeout_s="15.0"/>

      <!-- GUIDED to the waypoint, then MANUAL; MANUAL already: straight on -->
      <ReactiveFallback name="to_the_waypoint">
        <ModeIs mode="MANUAL"/>
        <Sequence>
          <ReactiveSequence name="guided_leg">
            <IsAutonomous/>
            <NotDropped/>
            <NavigateTo target="approach" tolerance="2.0"/>
          </ReactiveSequence>
          <RequestMode mode="MANUAL" from="GUIDED" timeout_s="1000000"/>
        </Sequence>
      </ReactiveFallback>

      <ReactiveSequence name="manual">
        <ModeIs mode="MANUAL"/>
        <NotDropped/>
        <UpdateDockBook/>
        <Sequence name="dock_and_fire">
          <Fallback name="the_green_bay">
            <BayChosen/>
            <ReactiveFallback name="search_until_green">
              <CommitFirstGreen bay="{bay}" min_reads="3" min_conf="0.5" min_obs="4" max_turn_deg="15"
                                off_is_green="true" bays="3"/>
              <StrafeSearch leg_m="20.0" lat_us="{t3_search_lat_us}" min_out_m="3.5" forever="true"/>
            </ReactiveFallback>
          </Fallback>

          <!-- success_count 1: done when the fire side is done (the dock side only holds) -->
          <Parallel name="dock_while_firing" success_count="1" failure_count="1">
            <Sequence name="dock">
              <!-- gains, the hold distance and the sideways offset: the GCS Run panel's "Task 3 control"
                   (bt_runner_node t3_*, t3_tuning.hpp), read at Start -->
              <ApproachBay fwd_us="{t3_app_fwd_us}" strafe_us="{t3_app_strafe_us}" slew_us_s="40" centre_tol_m="{t3_app_centre_tol_m}"
                           centred_s="{t3_app_centred_s}" recentre_m="{t3_app_recentre_m}" handover_m="{t3_handover_m}"
                           kp_lat="{t3_app_kp_lat}" kd_lat="{t3_app_kd_lat}" coast_s="{t3_app_coast_s}" min_us="{t3_app_min_us}"
                           kp_yaw="{t3_app_kp_yaw}" kd_yaw="{t3_app_kd_yaw}" lat_offset_m="{t3_lat_offset_m}"
                           use_lidar="{use_lidar}"/>
              <ReactiveSequence name="docked">
                <StrafeKeep fire_range_m="{hold_m}" use_lidar="{use_lidar}"
                            deadband_range_m="0.05" deadband_lat_m="0.04" deadband_yaw_deg="3.0"
                            kp_fwd="{t3_hold_kp_fwd}" kd_fwd="{t3_hold_kd_fwd}" ki_fwd="{t3_hold_ki_fwd}"
                            kp_lat="{t3_hold_kp_lat}" kd_lat="{t3_hold_kd_lat}" ki_lat="{t3_hold_ki_lat}"
                            kp_yaw="{t3_hold_kp_yaw}" kd_yaw="{t3_hold_kd_yaw}" i_max_us="100"
                            min_us="{t3_hold_min_us}" max_us="{t3_hold_max_us}" slew_us_s="200"
                            min_range_m="0.6" square_first_deg="10" lat_offset_m="{t3_lat_offset_m}"/>
                <Sequence name="on_station">
                  <AwaitStrafeSolution steady="false" fire_range_m="{t3_hold_m}" range_tol_m="0.40" lat_tol_m="0.30"
                                       yaw_tol_deg="10.0" hold_s="0.0" miss_s="1.0"/>
                  <ReportDocking bay="{bay}"/>
                  <KeepRunningUntilFailure>
                    <AlwaysSuccess/>
                  </KeepRunningUntilFailure>
                </Sequence>
              </ReactiveSequence>
            </Sequence>

            <!-- once per run: a restart after a Task 4 break-off skips what is done -->
            <Sequence name="the_fire">
              <Fallback name="fire_once">
                <ScriptCondition code="t3_fire_out"/>
                <Sequence>
                  <RetryUntilSuccessful num_attempts="-1">
                    <Sequence name="spray_it">
                      <AwaitFireTarget bay="{bay}" target="{target}" min_red_s="0.2"
                                       refire_red_s="1.5" timeout_s="1000000" resend_s="10.0"/>
                      <Script code="hold_m := t3_hold_m"/>
                      <SprayUntilHit target="{target}" window="{window}" timeout_s="1000000"
                                     min_green_s="0.4" max_aim_age_s="5.0"
                                     keep_after_docking="true"/>
                    </Sequence>
                  </RetryUntilSuccessful>
                  <Script code="t3_fire_out := true"/>
                  <ForceSuccess>
                    <ReportFirefighting window="{window}"/>
                  </ForceSuccess>
                </Sequence>
              </Fallback>
              <Script code="hold_m := t3_backoff_m"/>
              <Fallback name="request_once">
                <ScriptCondition code="t3_request_sent"/>
                <ForceSuccess>
                  <Sequence name="resource_request">
                    <DecodeResourceRequest request="{request}" timeout_s="80.0" hold_s="5.0"
                                           min_frames="20"/>
                    <ReportResourceDelivery request="{request}"/>
                    <Script code="t3_request_sent := true"/>
                  </Sequence>
                </ForceSuccess>
              </Fallback>
            </Sequence>
          </Parallel>
        </Sequence>
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>

</root>
