<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task1Core: Task 1 Safe Passage, Core tier (no aircraft; the boat sees the buoys itself).

  Outer ReactiveSequence = guard band, every child re-ticked at 10 Hz. Inner Sequence = the
  mission, which walks forward once. IsAutonomous and the task heartbeat (TaskAttempt) are in the
  Main tree that calls this.

  The transit ends on ARRIVING at the exit (NearExit), not on running out of buoys: NearExit
  succeeds, the Inverter fails the ReactiveSequence, KeepRunningUntilFailure returns FAILURE (it
  never converts it), and the ForceSuccess around it turns that into "carry on". exit_near_m
  must stay larger than orbit_radius_m or the transit would end inside the orbit.

  A leg blocked for 15 s FAILS: the transit leg is wrapped in ForceSuccess (skip it, pick the
  next waypoint) and the orbits in RetryUntilSuccessful. The mission timeout and cancel are in
  bt_runner_node, not here.
-->
<root BTCPP_format="4">

  <BehaviorTree ID="Task1Core">
    <ReactiveSequence name="guard_band">
      <ResolveBuoyStates/>
      <ReportSafePassage min_period_s="1.0"/>

      <Sequence name="passage">

        <!-- The team waypoint is a hint about where to look: bail once the entry resolves. -->
        <ReactiveFallback name="approach">
          <EntryResolved/>
          <RetryUntilSuccessful num_attempts="3">
            <NavigateTo target="approach" tolerance="{approach_tolerance_m}"/>
          </RetryUntilSuccessful>
        </ReactiveFallback>

        <!-- HoldStation never succeeds, so the Timeout is what ends the wait. -->
        <ReactiveFallback name="observe">
          <EntryResolved/>
          <Timeout msec="30000">
            <HoldStation/>
          </Timeout>
        </ReactiveFallback>

        <!-- Core: a full circle of the ENTRY buoy. -->
        <RetryUntilSuccessful num_attempts="3">
          <CircleBuoy anchor="entry" radius="{orbit_radius_m}" points="{orbit_points}"
                      direction="{entry_direction}"/>
        </RetryUntilSuccessful>

        <!-- ForceSuccess: the loop ending normally is "carry on", not a failed mission. -->
        <ForceSuccess>
          <KeepRunningUntilFailure name="transit">
            <ReactiveSequence>
              <Inverter>
                <NearExit radius="{exit_near_m}"/>
              </Inverter>
              <Sequence>
                <NextWaypoint offset="{waypoint_offset_m}"/>
                <!-- ForceSuccess: a blocked leg must not end the transit and skip every gate. -->
                <ForceSuccess>
                  <NavigateTo target="waypoint" tolerance="{transit_tolerance_m}"/>
                </ForceSuccess>
              </Sequence>
            </ReactiveSequence>
          </KeepRunningUntilFailure>
        </ForceSuccess>

        <!-- Only earns its keep if the transit ended without a resolved exit. -->
        <ReactiveFallback name="find_exit">
          <ExitResolved/>
          <Timeout msec="20000">
            <HoldStation/>
          </Timeout>
        </ReactiveFallback>

        <!-- Core: a full circle of the EXIT buoy; this completes the task. -->
        <RetryUntilSuccessful num_attempts="3">
          <CircleBuoy anchor="exit" radius="{orbit_radius_m}" points="{orbit_points}"
                      direction="{exit_direction}"/>
        </RetryUntilSuccessful>

      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="Task1Core">
      <input_port name="orbit_radius_m" default="6.0">orbit radius, metres (a real: write it with a decimal point)</input_port>
      <input_port name="orbit_points" default="8">waypoints on each orbit (a whole number)</input_port>
      <input_port name="entry_direction" default="cw">entry orbit direction: cw or ccw</input_port>
      <input_port name="exit_direction" default="ccw">exit orbit direction: cw or ccw</input_port>
      <input_port name="approach_tolerance_m" default="4.0">arrival radius at the team approach waypoint, metres</input_port>
      <input_port name="exit_near_m" default="8.0">transit ends this close to the exit, metres; keep above orbit_radius_m</input_port>
      <input_port name="waypoint_offset_m" default="4.0">how far to clear each buoy by, metres</input_port>
      <input_port name="transit_tolerance_m" default="2.5">arrival radius at each transit waypoint, metres</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
