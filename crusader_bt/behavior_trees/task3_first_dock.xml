<?xml version="1.0"?>
<!-- MISSION: Task 3 - GPS waypoint (GUIDED), then MANUAL: slide to the FIRST bay seen (any colour), close in, pan/tilt cannon. -->
<!--
  task3_first_dock.xml - task3_scan_fire.xml, except the search stops at the first bay it
  sees, whatever its indicator reads, instead of the first GREEN one, no RED window after
  docking means a window is sprayed anyway, and the transmitter does not gate it (no drop
  latch). Start it with an APPROACH POINT and the dock heading set, in GUIDED (to drive to
  the point) or MANUAL (to start the search where the boat is).

    camera: SetCameraModel puts camera_node on the dock model and waits until it sees with it.
    0. GUIDED to the approach point (skipped when the run starts in MANUAL).
    1. the tree switches GUIDED -> MANUAL itself.
    2. SEARCH: turn to the dock heading, slide one way (the Run panel's "slide first", else
       left) until a bay is confirmed (seen 4 times) and in view, with the bow within 15 deg
       of the dock heading (CommitFirstGreen colour="any"; several: the one nearest the
       bow's line). From here on that bay is ours, whatever it reads.
    From then on, two branches side by side (Parallel):
    3. APPROACH: square to the dock heading, strafe our bay's indicator (else its face) onto
       the bow's line, then a steady push straight in (ApproachBay), to 2.0 m and centred.
    4. HOLD: the camera 1.7 m off the face (hold_m), centred, square (StrafeKeep); on
       station -> the docking report.
    5. THE FIRE, in a loop: a window of our bay reads RED -> the cannon sprays it until it
       reads GREEN -> firefighting report -> the 2-colour code -> resource delivery report
       -> wait for the next RED (back at the 1.7 m hold).
       NO RED: docked 30 s with no window of ours read RED (and no fire out yet): back
       off to 2.0 m (hold_m; up to 20 s to settle), then spray one of our bay's windows
       anyway for 15 s (6.27 m/s reaches ~4 m level, so 2 m is well inside). That window
       reading GREEN is the hit (-> the reports, as above); else back to 1.7 m, wait 30 s
       for RED again, then try the other window.

  RoboCommand (via ocs_client and the OCS): the heartbeat says TASK_COORDINATED_LOGISTICS
  while this runs (TaskAttempt). The docking report names the bay, and RoboCommand lights
  a window in THAT bay: a bay committed before all three are seen is numbered from the
  bays seen either side and the slide direction, so START AT THE DOCK'S RIGHT END when
  sliding left (the first bay seen is then bay 3). A RED bay is still not the safe one.

  No drop latch (telemetry_bridge drop_channel 0): SC DOWN does NOT stop a run that is
  already in MANUAL. To take the boat back: SC to HOLD (the tree needs MANUAL, so the run
  ends and the bridge releases the sticks), then MANUAL. SB is the e-stop.
-->
<root BTCPP_format="4" main_tree_to_execute="FirstDock">
  <BehaviorTree ID="FirstDock">
    <!-- the heartbeat's current_task (handbook 3.4.11): TASK_COORDINATED_LOGISTICS from
         the first tick, TASK_NONE when the run ends; RoboCommand starts Task 3's
         attempt on it -->
    <TaskAttempt token="TASK_COORDINATED_LOGISTICS">
      <Sequence name="first_dock">
        <Script code="use_lidar := false"/>
        <!-- the hold's camera-to-face range: 1.7 docked, 2.0 for the no-RED shot -->
        <Script code="hold_m := 1.7"/>

        <SetCameraModel model="dock" indicator="yolo" timeout_s="15.0"/>

        <!-- 0-1. GUIDED to the waypoint, then MANUAL -->
        <Fallback name="to_the_waypoint">
          <ModeIs mode="MANUAL"/>
          <Sequence>
            <!-- no dock sightings here: placing them needs the heading, and it is poor
                 while the autopilot pivots onto the waypoint -->
            <ReactiveSequence name="guided_leg">
              <IsAutonomous/>
              <NavigateTo target="approach" tolerance="2.0"/>
            </ReactiveSequence>
            <RequestMode mode="MANUAL" from="GUIDED" timeout_s="1000000"/>
          </Sequence>
        </Fallback>

        <!-- 2-5. MANUAL on the sticks: only the pilot's switches end it (SC to HOLD, SB) -->
        <ReactiveSequence name="manual">
          <ModeIs mode="MANUAL"/>
          <UpdateDockBook/>
          <Sequence name="dock_and_fire">
            <Fallback name="the_first_bay">
              <BayChosen/>
              <ReactiveFallback name="search_until_a_bay">
                <CommitFirstGreen colour="any" bay="{bay}" min_obs="4" max_turn_deg="15"/>
                <!-- one way only: the GCS Run panel's "slide first" (bt_runner_node
                     search_first), LEFT when unset (start the run at the dock's right end).
                     leg_m is longer than the dock, so it never turns back; past it, it
                     would sweep back the other way -->
                <StrafeSearch leg_m="20.0" lat_us="100" min_out_m="3.5" forever="true"/>
              </ReactiveFallback>
            </Fallback>

            <!-- docking and the cannon side by side, from the moment the bay is chosen.
                 At the competition the RED window lights only after ReportDocking (3.3.4),
                 so the report stays on the docking side; at the lake the mock-up is lit
                 already and the cannon starts while the boat is still lining up. -->
            <Parallel name="dock_while_firing" success_count="-1" failure_count="1">
              <Sequence name="dock">
                <ApproachBay fwd_us="60" strafe_us="100" slew_us_s="40" centre_tol_m="0.15"
                             centred_s="1.0" recentre_m="0.40" kp_lat="100" kd_lat="40"
                             handover_m="2.0" use_lidar="{use_lidar}"/>
                <ReactiveSequence name="docked">
                  <StrafeKeep fire_range_m="{hold_m}" use_lidar="{use_lidar}"
                              deadband_range_m="0.05" deadband_lat_m="0.04" deadband_yaw_deg="3.0"
                              kp_fwd="90" kd_fwd="60" kp_lat="100" kd_lat="200" kp_yaw="5" kd_yaw="0.5"
                              ki_fwd="40" ki_lat="10" i_max_us="100"
                              min_us="30" max_us="120" slew_us_s="200"
                              min_range_m="0.6" square_first_deg="10"/>
                  <Sequence name="on_station">
                    <AwaitStrafeSolution fire_range_m="1.7" range_tol_m="0.40" lat_tol_m="0.30"
                                         yaw_tol_deg="10.0" hold_s="0.5"/>
                    <AwaitStrafeSolution fire_range_m="1.7" range_tol_m="0.10" lat_tol_m="0.15"
                                         yaw_tol_deg="8.0" hold_s="2.0"/>
                    <ReportDocking bay="{bay}"/>
                    <KeepRunningUntilFailure>
                      <AlwaysSuccess/>
                    </KeepRunningUntilFailure>
                  </Sequence>
                </ReactiveSequence>
              </Sequence>
              <!-- the cannon: our bay's window RED for 0.2 s -> spray it until GREEN, through
                   drop-outs of up to 5 s (once docked, through any drop-out, re-aimed when
                   the window is seen again) -> firefighting report -> the 2-colour code ->
                   resource delivery report -> wait for the next RED.
                   No RED 30 s after docking, no fire out yet: back off to 2 m, spray one of
                   our windows anyway for 15 s, GREEN = the hit; else back in to 1.7 m, wait
                   30 s for RED again, the other window next -->
              <KeepRunningUntilFailure>
                <ForceSuccess>
                  <Sequence name="one_fire">
                    <Script code="hold_m := 1.7"/>
                    <Fallback name="red_else_any_window">
                      <Sequence name="red_window">
                        <AwaitFireTarget bay="{bay}" target="{target}" min_red_s="0.2"
                                         refire_red_s="1.5" timeout_s="1000000" resend_s="10.0"
                                         no_red_s="30.0"/>
                        <SprayUntilHit target="{target}" window="{window}" timeout_s="1000000"
                                       min_green_s="0.4" max_aim_age_s="5.0"
                                       keep_after_docking="true"/>
                      </Sequence>
                      <Sequence name="no_red_window">
                        <PickAnyWindow target="{target}"/>
                        <Script code="hold_m := 2.0"/>
                        <ForceSuccess>
                          <AwaitStrafeSolution fire_range_m="2.0" range_tol_m="0.15"
                                               lat_tol_m="0.30" yaw_tol_deg="10.0" hold_s="1.0"
                                               timeout_s="20.0"/>
                        </ForceSuccess>
                        <SprayUntilHit target="{target}" window="{window}" timeout_s="15.0"
                                       min_green_s="0.4" max_aim_age_s="5.0"
                                       keep_after_docking="true" green_is_hit="true"/>
                      </Sequence>
                    </Fallback>
                    <ReportFirefighting window="{window}"/>
                    <DecodeResourceRequest request="{request}" timeout_s="80.0" hold_s="5.0"
                                           min_frames="20"/>
                    <ReportResourceDelivery request="{request}"/>
                  </Sequence>
                </ForceSuccess>
              </KeepRunningUntilFailure>
            </Parallel>
          </Sequence>
        </ReactiveSequence>
      </Sequence>
    </TaskAttempt>
  </BehaviorTree>
</root>
