<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Competition run - wait for RoboCommand RunStart, then Task 1 (whole field) and Task 3. -->
<!--
  Competition mission: hold station until RoboCommand's RunStart, then Task 1 and Task 3, each
  its own task attempt. Start it once the boat is armed and in GUIDED, tier set on the Start
  button (SetTier can change it between tasks). timeout_s of WaitForRunStart is 0: wait forever.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/task1_global.xml"/>
  <include path="lib/task3_disruptive.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence name="guard">
      <IsAutonomous/>
      <Sequence name="mission">
        <WaitForRunStart max_age_s="30.0" timeout_s="0.0" hold="true"/>
        <TaskAttempt token="TASK_SAFE_PASSAGE">
          <SubTree ID="Task1Global" _autoremap="true"
                 orbit_radius_m=""
                 orbit_min_m="1.5"
                 overshoot_deg="45.0"
                 lookahead_m="2.5"
                 blocked_timeout_s="15.0"
                 plan_attempts="4"
                 plan_max_age_s="15.0"
                 confirm_timeout_s="120.0"/>
        </TaskAttempt>
        <TaskAttempt token="TASK_COORDINATED_LOGISTICS">
          <SubTree ID="Task3Disruptive" _autoremap="true"
                 vantage_standoff_m="5.0"
                 predock_m="3.0"
                 berth_m="1.25"
                 lead_m="2.0"
                 berth_tolerance_m="0.25"
                 spray_timeout_s="60.0"
                 decode_timeout_s="80.0"
                 camera_max_age_s="3.0"/>
        </TaskAttempt>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>
