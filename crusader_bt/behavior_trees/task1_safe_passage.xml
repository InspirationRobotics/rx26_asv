<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Task 1 Safe Passage, Core tier (no aircraft). -->
<!--
  The tree is Task1Core, in lib/task1_safe_passage.xml. This adds the autonomy guard and the
  task heartbeat, so it runs on its own as RunMission name task1_safe_passage.
  Every tunable is written out with its default.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/task1_safe_passage.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <IsAutonomous/>
      <TaskAttempt token="TASK_SAFE_PASSAGE">
        <SubTree ID="Task1Core" _autoremap="true"
                 orbit_radius_m="6.0"
                 orbit_points="8"
                 entry_direction="cw"
                 exit_direction="ccw"
                 approach_tolerance_m="4.0"
                 exit_near_m="8.0"
                 waypoint_offset_m="4.0"
                 transit_tolerance_m="2.5"/>
      </TaskAttempt>
    </ReactiveSequence>
  </BehaviorTree>
</root>
