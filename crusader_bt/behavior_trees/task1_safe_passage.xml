<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task 1 Safe Passage.

  TWO BANDS, and the split is the design.

  The outer ReactiveSequence is the GUARD BAND: every child runs on every tick,
  10 Hz, for the whole mission. Perception updates, the report goes out, and
  autonomy is re-checked. Because IsAutonomous sits above everything, the pilot
  moving SC out of GUIDED halts whatever is running below within one tick. That
  is one line of XML replacing a check that would otherwise live in every leaf.

  The inner Sequence is the MISSION BAND: it has memory, so it walks forward
  once. SetTask fires at tick 1 and is never touched again.

  WHAT ENDS THE TRANSIT IS ARRIVING AT THE EXIT, not running out of buoys.
  NearExit succeeds -> Inverter turns that into FAILURE -> the ReactiveSequence
  halts the running leg and fails -> KeepRunningUntilFailure returns FAILURE ->
  and the ForceSuccess around it turns that into "carry on".

  Ending on an empty candidate list instead would make one missed detection stop
  the boat mid-field, and would make the task's actual objective implicit. NextWaypoint's own FAILURE is kept only as a secondary way out.

  NearExit radius MUST stay larger than CircleBuoy radius (8 > 6), or transit
  would stop inside the orbit and the circle would start from the wrong place.

  The mission timeout and cancel are NOT here. They live in bt_runner_node, so a
  tree that somehow never terminates still cannot strand the boat.

  Obstacle avoidance lives in the tree, not in the autopilot: NavigateTo and
  CircleBuoy plan around every known object through Nav2's planner_server
  (bt_runner_node's nav_mode, docs/nav2_avoidance_spec.md) and HOLD when they
  cannot plan. A leg that stays blocked FAILS after 15 s, so the transit leg is
  wrapped in ForceSuccess (a blocked leg is skipped and the next waypoint is
  chosen) and the others in RetryUntilSuccessful. ArduRover's own avoidance is at
  most a backstop and is off in the baseline (PRX1_TYPE 0).
-->
<root BTCPP_format="4" main_tree_to_execute="SafePassage">
  <BehaviorTree ID="SafePassage">
    <ReactiveSequence name="guard_band">

      <IsAutonomous/>
      <ResolveBuoyStates/>
      <PublishSafePassageReport min_period_s="1.0"/>

      <Sequence name="passage">

        <!-- The course activates its beacons only once we report the attempt. -->
        <SetTask token="TASK_SAFE_PASSAGE"/>

        <!-- Drive the team waypoint, but bail the moment the entry resolves:
             the waypoint is a hint about where to look, not a place to touch. -->
        <ReactiveFallback name="approach">
          <EntryResolved/>
          <RetryUntilSuccessful num_attempts="3">
            <NavigateTo target="approach" tolerance="4.0"/>
          </RetryUntilSuccessful>
        </ReactiveFallback>

        <!-- Hold station until it resolves, or give up. HoldStation never
             succeeds on its own, so the Timeout is what ends this. -->
        <ReactiveFallback name="observe">
          <EntryResolved/>
          <Timeout msec="30000">
            <HoldStation/>
          </Timeout>
        </ReactiveFallback>

        <!-- Core Tier: a FULL circle of the ENTRY buoy, CLOCKWISE. -->
        <RetryUntilSuccessful num_attempts="3">
          <CircleBuoy anchor="entry" radius="6.0" points="8" direction="cw"/>
        </RetryUntilSuccessful>

        <!-- The gate count is unknown, so it is not in this file.

             THE ForceSuccess IS NOT DECORATION. KeepRunningUntilFailure returns
             FAILURE when its child finally fails — verified in BT.CPP's own
             source, decorators/keep_running_until_failure_node.h. It does NOT
             convert that into SUCCESS. So the loop ending normally (NearExit
             fires -> Inverter -> the ReactiveSequence fails) would fail the
             whole mission and the boat would never circle the exit buoy. The
             ForceSuccess is what turns "the loop finished" into "carry on". -->
        <ForceSuccess>
          <KeepRunningUntilFailure name="transit">
            <ReactiveSequence>
              <Inverter>
                <NearExit radius="8.0"/>
              </Inverter>
              <Sequence>
                <NextWaypoint offset="4.0"/>
                <!-- THE ForceSuccess IS LOAD-BEARING. A blocked leg FAILS, and
                     without it that FAILURE would end the transit through
                     KeepRunningUntilFailure and skip every gate. With it the
                     Sequence succeeds, the loop comes round, and NextWaypoint
                     chooses again. -->
                <ForceSuccess>
                  <NavigateTo target="waypoint" tolerance="2.5"/>
                </ForceSuccess>
              </Sequence>
            </ReactiveSequence>
          </KeepRunningUntilFailure>
        </ForceSuccess>

        <!-- Only earns its keep if transit ended without a resolved exit. -->
        <ReactiveFallback name="find_exit">
          <ExitResolved/>
          <Timeout msec="20000">
            <HoldStation/>
          </Timeout>
        </ReactiveFallback>

        <!-- Core Tier: a FULL circle of the EXIT buoy, COUNTERCLOCKWISE.
             This is what completes the task. -->
        <RetryUntilSuccessful num_attempts="3">
          <CircleBuoy anchor="exit" radius="6.0" points="8" direction="ccw"/>
        </RetryUntilSuccessful>

      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>
