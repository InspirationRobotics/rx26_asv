<?xml version="1.0"?>
<!-- MISSION: Test - pan/tilt cannon in MANUAL, started close: hold 1.2 m off the bay, spray each RED window until GREEN. -->
<!--
  task3_cannon_fire.xml - the second half of task3_scan_fire on its own, for a boat the
  pilot has already brought in front of the dock (MANUAL, bow on it, the dock in view).

    the bay      the first bay that reads GREEN (CommitFirstGreen), waiting until one does
    hold         the bay's face at 1.2 m, centred, square (StrafeKeep)
    docked       on station, then held tight for 2 s -> the docking report
    the fire     in a loop: steady RED -> spray until GREEN -> firefighting report ->
                 the 2-colour code -> resource delivery report

  No timeouts: only the pilot's switches end it (SC out of MANUAL, or SD); SB is the
  e-stop. use_lidar / dock_heading as in task3_scan_fire.xml.
-->
<root BTCPP_format="4" main_tree_to_execute="CannonFire">
  <BehaviorTree ID="CannonFire">
    <Sequence>
      <Script code="use_lidar := false"/>
      <Script code="dock_heading := 290.0"/>
      <ReactiveSequence name="manual">
        <ModeIs mode="MANUAL"/>
        <NotDropped/>
        <UpdateDockBook/>
        <Sequence name="dock_and_fire">
          <RetryUntilSuccessful num_attempts="-1">
            <Fallback>
              <CommitFirstGreen bay="{bay}" min_votes="8" min_share="0.8"/>
              <ForceFailure>
                <Sleep msec="500"/>
              </ForceFailure>
            </Fallback>
          </RetryUntilSuccessful>
          <ReactiveSequence name="docked">
            <StrafeKeep fire_range_m="1.2" heading_deg="{dock_heading}" use_lidar="{use_lidar}"
                        deadband_range_m="0.05" deadband_lat_m="0.04" deadband_yaw_deg="3.0"
                        kp_fwd="90" kd_fwd="60" kp_lat="100" kd_lat="200" kp_yaw="5" kd_yaw="0.5"
                        ki_fwd="40" ki_lat="10" i_max_us="100"
                        min_us="30" max_us="120" slew_us_s="200"
                        min_range_m="0.6" square_first_deg="10"/>
            <Sequence name="on_station_then_fire">
              <AwaitStrafeSolution fire_range_m="1.2" range_tol_m="0.40" lat_tol_m="0.30"
                                   yaw_tol_deg="10.0" hold_s="0.5"/>
              <AwaitStrafeSolution fire_range_m="1.2" range_tol_m="0.10" lat_tol_m="0.15"
                                   yaw_tol_deg="8.0" hold_s="2.0"/>
              <ReportDocking bay="{bay}"/>
              <KeepRunningUntilFailure>
                <ForceSuccess>
                  <Sequence name="one_fire">
                    <AwaitFireTarget bay="{bay}" timeout_s="1000000" resend_s="10.0"/>
                    <SprayUntilHit window="{window}" timeout_s="1000000" min_green_s="0.4"
                                   max_aim_age_s="3.0"/>
                    <ReportFirefighting window="{window}"/>
                    <DecodeResourceRequest request="{request}" timeout_s="80.0" hold_s="5.0"
                                           min_frames="20"/>
                    <ReportResourceDelivery request="{request}"/>
                  </Sequence>
                </ForceSuccess>
              </KeepRunningUntilFailure>
            </Sequence>
          </ReactiveSequence>
        </Sequence>
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>
</root>
