<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Task 3 Coordinated Logistics, USV half (find the bay, dock, fire, decode). -->
<!--
  The tree is Task3Disruptive, in lib/task3_disruptive.xml. This adds the autonomy guard and the
  task heartbeat, so TREE=task3_disruptive.xml keeps working in the sim and lake rigs.
  Every tunable is written out with its default.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/task3_disruptive.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <IsAutonomous/>
      <TaskAttempt token="TASK_COORDINATED_LOGISTICS">
        <SubTree ID="Task3Disruptive" _autoremap="true"
                 vantage_standoff_m="5.0"
                 predock_m="3.0"
                 berth_m="1.25"
                 lead_m="2.0"
                 berth_tolerance_m="0.25"
                 spray_timeout_s="60.0"
                 decode_timeout_s="80.0"
                 camera_max_age_s="3.0"/>
      </TaskAttempt>
    </ReactiveSequence>
  </BehaviorTree>
</root>
