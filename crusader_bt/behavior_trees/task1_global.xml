<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Task 1 Safe Passage above Core, whole-field planner. -->
<!--
  The tree is Task1Global, in lib/task1_global.xml. This adds the autonomy guard and the
  task heartbeat.
  Every tunable is written out with its default.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/task1_global.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <IsAutonomous/>
      <TaskAttempt token="TASK_SAFE_PASSAGE">
        <SubTree ID="Task1Global" _autoremap="true"
                 orbit_radius_m=""
                 orbit_min_m="1.5"
                 overshoot_deg="45.0"
                 lookahead_m="2.5"
                 blocked_timeout_s="15.0"
                 plan_attempts="4"/>
      </TaskAttempt>
    </ReactiveSequence>
  </BehaviorTree>
</root>
