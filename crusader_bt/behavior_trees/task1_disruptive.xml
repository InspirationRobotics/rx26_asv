<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Task 1 Safe Passage, Disruptive: Advanced, and stop when Ekko's field goes stale. -->
<!--
  The tree is Task1Disruptive, in lib/task1_disruptive.xml. Its shared body, lib/common/task1_plan_drive.xml,
  is included once, here. This adds the autonomy guard; the task heartbeat is inside the tree.
  Every tunable is written out with its default.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/common/task1_plan_drive.xml"/>
  <include path="lib/task1_disruptive.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <IsAutonomous/>
      <SubTree ID="Task1Disruptive" _autoremap="true"
               orbit_radius_m=""
               orbit_min_m="1.5"
               overshoot_deg="45.0"
               lookahead_m="2.5"
               blocked_timeout_s="15.0"
               plan_attempts="4"
               plan_max_age_s="15.0"/>
    </ReactiveSequence>
  </BehaviorTree>
</root>
