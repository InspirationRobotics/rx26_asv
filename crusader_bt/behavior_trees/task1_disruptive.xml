<?xml version="1.0" encoding="UTF-8"?>
<!-- MISSION: Task 1 Safe Passage, Advanced/Disruptive tier, gate by gate. -->
<!--
  The tree is Task1Disruptive, in lib/task1_disruptive.xml. This adds the autonomy guard and the
  task heartbeat, so TREE=task1_disruptive.xml keeps working in the sim and lake rigs.
  Every tunable is written out with its default.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="lib/task1_disruptive.xml"/>

  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <IsAutonomous/>
      <TaskAttempt token="TASK_SAFE_PASSAGE">
        <SubTree ID="Task1Disruptive" _autoremap="true"
                 orbit_points=""
                 orbit_radius_m=""
                 entry_direction="cw"
                 exit_direction="ccw"
                 confirm_timeout_s="120.0"
                 plan_max_age_s="15.0"
                 gate_max_width_m="20.0"
                 gate_min_width_m="2.0"/>
      </TaskAttempt>
    </ReactiveSequence>
  </BehaviorTree>
</root>
