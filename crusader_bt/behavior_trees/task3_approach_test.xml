<?xml version="1.0"?>
<!--
  task3_approach_test.xml - TEST VARIANT of task3_disruptive.xml: the GPS
  approach only, against a practice dock. Find the GREEN bay, commit, drive the
  lead-in and the line-up legs in GUIDED, then STOP and hold at the line-up
  point. No entering the slip, no berth, no fire, no reports.

  Run it with bt_runner_node dock_bays:=1 against a single practice bay (the
  course has three; dock::layout() will not number fewer than dock_bays).

  WHAT DIFFERS FROM task3_disruptive.xml, and why:
    * it ends after line_up: the berth needs better than plain GPS (1-3 m) and
      real slip fingers, neither of which the practice pool has
    * line-up is 4.0 m from the face, not 3.0: margin for the GPS error
    * one look instead of four before the lenient pick
  Everything it does run is the mission's own leaves with the mission's own
  numbers, so a pass here is a pass for those legs.

  PRECONDITIONS: start the boat FACING the bay (the goal carries no approach
  point, so a bay not seen at the start cannot be searched for), GUIDED on SC,
  and WP_RADIUS well under 1 m for the test (2.0 parks the boat 2 m short of
  every point; see task3_disruptive.xml point 5).
-->
<root BTCPP_format="4" main_tree_to_execute="ApproachTest">
  <BehaviorTree ID="ApproachTest">
    <ReactiveSequence name="guard_band">

      <IsAutonomous/>
      <DockCameraAlive max_age_s="3.0"/>
      <UpdateDockBook/>

      <Sequence name="approach">

        <SetTask token="TASK_COORDINATED_LOGISTICS"/>

        <RetryUntilSuccessful num_attempts="3" name="dock_attempts">
          <Sequence name="find_and_line_up">

            <ReactiveFallback name="find_safe_bay">
              <SafeBayKnown need_others_red="true"/>
              <RetryUntilSuccessful num_attempts="1" name="looks">
                <Sequence name="look">
                  <PickVantage standoff="5.0" lead_m="2.0" out="{vantage}" lead="{lead}"/>
                  <NavigateTo target="port" goal="{lead}" tolerance="1.0"/>
                  <NavigateTo target="port" goal="{vantage}" tolerance="1.0"/>
                  <ForceFailure>
                    <Sleep msec="12000"/>
                  </ForceFailure>
                </Sequence>
              </RetryUntilSuccessful>
              <SafeBayKnown need_others_red="false"/>
            </ReactiveFallback>

            <CommitSafeBay/>

            <Fallback name="lead_in">
              <LinedUp min_along_m="3.7" lateral_tol="0.4" heading_tol_deg="20.0"/>
              <ReactiveSequence name="to_lead">
                <ChosenBaySafe min_ema="0.3"/>
                <DockWaypoint point="lead" predock_m="4.0" berth_m="1.25" lead_m="2.0" out="{goal}"/>
                <NavigateTo target="port" goal="{goal}" tolerance="1.0"/>
              </ReactiveSequence>
            </Fallback>
            <ReactiveSequence name="line_up">
              <ChosenBaySafe min_ema="0.3"/>
              <DockWaypoint point="predock" predock_m="4.0" berth_m="1.25" lead_m="2.0" out="{goal}"/>
              <NavigateTo target="port" goal="{goal}" tolerance="0.4" resend_m="0.2"/>
            </ReactiveSequence>

          </Sequence>
        </RetryUntilSuccessful>

      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>
