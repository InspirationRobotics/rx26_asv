<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_link</name>
  <version>0.2.0</version>
  <description>
    The boat's end of the RFD900 mesh to Ekko: TUNNEL v3 frames in (the passage plan), the
    BOAT packet out. It talks to the radio, never to the Pixhawk.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>crusader_msgs</depend>
  <depend>crusader_common</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
