# Generated by gen_udev_rules.py from crusader.json -- do not hand-edit;
# re-run the generator after any cabling change (discover new paths with
# usbLink.sh or: udevadm info -q property -n /dev/ttyACM0 | grep DEVPATH).
# Port-chain (KERNELS) matching: device identity = which physical port
# it is plugged into. Keep cabling fixed; label the hub ports.

# teensy: port chain 1-2.2:1.0
SUBSYSTEM=="tty", KERNELS=="1-2.2:1.0", SYMLINK+="crsd-teensy", MODE="0660", GROUP="dialout"

# ball_launcher: port chain 1-2.4.3:1.0
SUBSYSTEM=="tty", KERNELS=="1-2.4.3:1.0", SYMLINK+="crsd-ball-launcher", MODE="0660", GROUP="dialout"

# gps: port chain 1-2.1:1.0
SUBSYSTEM=="tty", KERNELS=="1-2.1:1.0", SYMLINK+="crsd-gps", MODE="0660", GROUP="dialout"

# oakd_lr: matched by its own id (UNSET), not a udev tty rule (depthai enumerates it; VID rule in 99-crusader.rules grants permissions)

# led: port chain 1-2.4.4:1.0
SUBSYSTEM=="tty", KERNELS=="1-2.4.4:1.0", SYMLINK+="crsd-led", MODE="0660", GROUP="dialout"

