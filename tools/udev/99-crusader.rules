# Crusader (RX26) udev rules — stable device names + permissions.
# Install with install_udev.sh, which also helps you fill in the serial numbers below.
#
# Discover attrs for a plugged-in device:
#   udevadm info -a -n /dev/ttyACM0 | grep -E 'idVendor|idProduct|serial' | head
#
# NOTE: fill in ATTRS{serial} per-boat where marked TODO — two devices sharing a
# VID/PID (e.g. two u-blox GPS units) are only distinguishable by serial.

# --- Pixhawk (autopilot). Owned exclusively by MAVProxy; everything else uses the
#     rebroadcast. The symlink exists so mavproxy.service never chases ttyACM numbering.
#     Common VID/PIDs: 3DR 26ac:*, Holybro/ArduPilot 1209:5740/5741, CubePilot 2dae:*
#     5741 is what Crusader's board actually enumerates as (confirmed on the
#     Jetson: usb-ArduPilot_Pixhawk1_3A001F00...). 5740 stays for other boards.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5740", SYMLINK+="crsd-pixhawk", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5741", SYMLINK+="crsd-pixhawk", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="26ac", SYMLINK+="crsd-pixhawk", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2dae", SYMLINK+="crsd-pixhawk", MODE="0660", GROUP="dialout"

# --- LED Arduino (led_node serial target; auto-reconnect logic expects a stable path)
#     Arduino VIDs: 2341 (genuine), 1a86 (CH340 clones), 0403 (FTDI)
#     TODO: add ATTRS{serial}=="XXXX" if any other CH340/FTDI device is ever aboard.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", SYMLINK+="crsd-led", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="crsd-led", MODE="0660", GROUP="dialout"

# --- RTK GPS units (u-blox 1546:01a9). Dual-antenna moving-baseline pair -> the two
#     units MUST be told apart by serial or physical port; fill in per-boat.
# TODO: ATTRS{serial}=="TODO_BASE_SERIAL"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", ATTRS{serial}=="TODO_GPS1_SERIAL", SYMLINK+="crsd-gps1", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", ATTRS{serial}=="TODO_GPS2_SERIAL", SYMLINK+="crsd-gps2", MODE="0660", GROUP="dialout"

# --- OAK-D LR (Luxonis / Intel Movidius). Not a tty; needs plugdev access and, in
#     bootloader/runtime, shows as 03e7:2485 (unbooted) then 03e7:f63b (booted).
SUBSYSTEM=="usb", ATTRS{idVendor}=="03e7", MODE="0666", GROUP="plugdev"

# --- 915MHz telemetry radio (SiK, usually FTDI 0403:6001 or Silabs 10c4:ea60)
#     TODO: confirm VID/PID and add serial if it collides with anything else.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="crsd-telem", MODE="0660", GROUP="dialout"
