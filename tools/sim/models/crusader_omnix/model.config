<?xml version="1.0"?>
<model>
  <name>Crusader OmniX</name>
  <version>0.1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    Crusader USV (FRAME_TYPE=2 OmniX) for Gazebo + ArduPilot SITL.
    Models four-thruster lateral thrust, which SITL's motorboat frame cannot —
    the limitation documented in docker/sitl/run_sitl.sh. Hydrodynamic
    coefficients are ESTIMATES pending trial fitting.
  </description>
</model>
