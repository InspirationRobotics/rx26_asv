<?xml version="1.0"?>
<!--
  Crusader — OmniX USV for Gazebo + ArduPilot SITL.

  THE POINT OF THIS FILE
  ======================
  Crusader is FRAME_TYPE=2 (OmniX): four thrusters at 45 deg in an X, genuinely
  holonomic. SITL's built-in "motorboat" frame cannot represent that, which is
  why docker/sitl/run_sitl.sh warns that "strafe dynamics are not [exact]" and
  why dp_hold has only ever had logic-level testing.

  This model gives ArduPilot four independently-commanded thrusters with real
  geometry, so lateral thrust is physically simulated. dp_hold, station-keeping
  in wind, and the Task 3 docking approach become testable off the water.

  THRUSTER LAYOUT (looking down, +x forward, +y port, ENU)

           bow
        FS \   / FP          FP front-port    thrust axis  +45 deg
            \ /              FS front-stbd    thrust axis  -45 deg
            / \              AP aft-port      thrust axis  -45 deg
        AP /   \ AS          AS aft-stbd      thrust axis  +45 deg
          stern

  Opposing diagonals produce surge; the other pair produces sway; differential
  produces yaw. That is the OmniX mixer ArduRover implements for FRAME_TYPE=2 —
  the control channel order below MUST match ArduRover's OmniX motor ordering
  (SERVO1..4 -> motors 1..4) or the vehicle will translate when asked to rotate.
  VERIFY against your working_crusader_params.params SERVO*_FUNCTION mapping on
  first bring-up; this is the single most likely thing to be wrong here.

  ** EVERY HYDRODYNAMIC NUMBER BELOW IS AN ESTIMATE, NOT A MEASUREMENT. **
  They are scaled from a comparable hull and produce the right ORDER of
  behaviour, nothing more. Fit them from real trials before quoting any absolute
  result: step-thrust -> drag, turning-circle -> yaw drag, coast-down -> added
  mass. Until then treat gazebo-backend numbers as RELATIVE comparisons between
  mechanisms, exactly as you would treat kinematic-backend numbers.

  Generated worlds reference this by name; GZ_SIM_RESOURCE_PATH is set by
  docker/sitl/run_sitl_gazebo.sh.
-->
<sdf version="1.10">
  <model name="crusader_omnix">

    <link name="base_link">
      <inertial>
        <mass>35.0</mass>
        <pose>0 0 -0.05 0 0 0</pose>
        <inertia>
          <ixx>3.12</ixx>
          <iyy>9.04</iyy>
          <izz>10.99</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="hull_collision">
        <geometry><box><size>1.80 1.10 0.45</size></box></geometry>
      </collision>

      <visual name="hull_visual">
        <geometry><box><size>1.80 1.10 0.45</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.32 1</ambient>
          <diffuse>0.32 0.36 0.42 1</diffuse>
        </material>
      </visual>

      <!--
        Visual mode indicator (auto / manual / kill).
        Not decoration: Handbook 3.1.2 requires a video segment demonstrating
        the visual feedback system for Proof of Readiness, and having it in sim
        means that part of the submission can be rehearsed.
      -->
      <visual name="mode_indicator">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <emissive>0 1 0 1</emissive>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
      </sensor>

      <sensor name="gps_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>

    <!-- ================== THRUSTERS ================== -->
    <!-- Positions/axes are the OmniX X-layout described above. -->

    <link name="thruster_fp">
      <pose>0.60 0.42 -0.10 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><cylinder><radius>0.06</radius>
        <length>0.04</length></cylinder></geometry></visual>
    </link>
    <joint name="thruster_fp_joint" type="revolute">
      <parent>base_link</parent><child>thruster_fp</child>
      <axis><xyz>0.707 0.707 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="thruster_fs">
      <pose>0.60 -0.42 -0.10 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><cylinder><radius>0.06</radius>
        <length>0.04</length></cylinder></geometry></visual>
    </link>
    <joint name="thruster_fs_joint" type="revolute">
      <parent>base_link</parent><child>thruster_fs</child>
      <axis><xyz>0.707 -0.707 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="thruster_ap">
      <pose>-0.70 0.42 -0.10 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><cylinder><radius>0.06</radius>
        <length>0.04</length></cylinder></geometry></visual>
    </link>
    <joint name="thruster_ap_joint" type="revolute">
      <parent>base_link</parent><child>thruster_ap</child>
      <axis><xyz>0.707 -0.707 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="thruster_as">
      <pose>-0.70 -0.42 -0.10 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><cylinder><radius>0.06</radius>
        <length>0.04</length></cylinder></geometry></visual>
    </link>
    <joint name="thruster_as_joint" type="revolute">
      <parent>base_link</parent><child>thruster_as</child>
      <axis><xyz>0.707 0.707 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Thruster plugins: one per unit, matching the joints above. -->
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>thruster_fp_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.12</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>thruster_fs_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.12</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>thruster_ap_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.12</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>thruster_as_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.12</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <!--
      Hydrodynamics — ESTIMATES. Fit before quoting absolute numbers.
      Sway drag (yV/yVV) is deliberately much larger than surge: a hull this
      shape resists lateral motion far more than forward motion, and getting
      that ratio wrong is precisely what would make dp_hold look easier in sim
      than it is on the water.
    -->
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>-12.0</xDotU>
      <yDotV>-45.0</yDotV>
      <zDotW>-80.0</zDotW>
      <kDotP>-2.0</kDotP>
      <mDotQ>-8.0</mDotQ>
      <nDotR>-6.0</nDotR>
      <xU>-35.0</xU>
      <yV>-180.0</yV>
      <zW>-300.0</zW>
      <kP>-20.0</kP>
      <mQ>-60.0</mQ>
      <nR>-45.0</nR>
      <xUU>-50.0</xUU>
      <yVV>-450.0</yVV>
      <zWW>-600.0</zWW>
      <kPP>-30.0</kPP>
      <mQQ>-90.0</mQQ>
      <nRR>-70.0</nRR>
    </plugin>

    <!-- Freshwater: Marina Bay is a non-tidal reservoir behind the barrage. -->
    <plugin filename="gz-sim-buoyancy-engine-system"
            name="gz::sim::systems::BuoyancyEngine">
      <link_name>base_link</link_name>
      <fluid_density>1000</fluid_density>
      <default_volume>0.0350</default_volume>
    </plugin>

    <!--
      ArduPilot bridge.

      fdm_port_in 9002 is what GazeboBackend probes to confirm Gazebo is really
      driving the FDM. If nothing holds that port, SITL silently falls back to
      the motorboat model and the strafe results are not real — so the backend
      refuses to run rather than reporting them.

      CONTROL CHANNEL ORDER MUST MATCH ArduRover's OmniX motor ordering.
      Verify against SERVO*_FUNCTION in working_crusader_params.params on first
      bring-up: if channels are permuted the boat will translate when commanded
      to rotate, which looks like a controller bug and is not.
    -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <control channel="0">
        <jointName>thruster_fp_joint</jointName>
        <useForce>1</useForce><multiplier>90</multiplier><offset>-0.5</offset>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <cmd_max>1000</cmd_max><cmd_min>-1000</cmd_min>
      </control>
      <control channel="1">
        <jointName>thruster_fs_joint</jointName>
        <useForce>1</useForce><multiplier>90</multiplier><offset>-0.5</offset>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <cmd_max>1000</cmd_max><cmd_min>-1000</cmd_min>
      </control>
      <control channel="2">
        <jointName>thruster_ap_joint</jointName>
        <useForce>1</useForce><multiplier>90</multiplier><offset>-0.5</offset>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <cmd_max>1000</cmd_max><cmd_min>-1000</cmd_min>
      </control>
      <control channel="3">
        <jointName>thruster_as_joint</jointName>
        <useForce>1</useForce><multiplier>90</multiplier><offset>-0.5</offset>
        <type>VELOCITY</type><p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <cmd_max>1000</cmd_max><cmd_min>-1000</cmd_min>
      </control>
    </plugin>

  </model>
</sdf>
