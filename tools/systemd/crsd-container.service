# /etc/systemd/system/crsd-container.service  (Jetson host)
#
# TEMPLATE: __CRSD_USER__ / __CRSD_CONTAINER__ are substituted by
# setup/install_jetson_host.sh at install time. Do NOT `install` this file
# verbatim — the placeholders must be expanded.
# Starts the __CRSD_CONTAINER__ ROS 2 container after MAVProxy owns the Pixhawk, so no
# node ever races MAVProxy for the serial device.
[Unit]
Description=Crusader ROS 2 container
# crsd-power BEFORE the container, because the container bind-mounts
# /run/crsd-power.sock (that is how the ground station's shutdown button
# reaches the host). Docker resolves bind sources at container START, and if
# the socket does not exist yet Docker HELPFULLY CREATES A DIRECTORY at that
# path — after which the helper cannot bind its socket and the button is dead
# until someone deletes the directory by hand. Wants=, not Requires=: if the
# helper is genuinely broken the boat should still come up and drive, just
# without a shutdown button.
After=docker.service crsd-mavproxy.service crsd-power.service
Requires=docker.service
Wants=crsd-mavproxy.service crsd-power.service

[Service]
Type=simple
User=__CRSD_USER__
ExecStart=/usr/bin/docker start -a __CRSD_CONTAINER__
ExecStop=/usr/bin/docker stop -t 10 __CRSD_CONTAINER__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
