# /etc/systemd/system/crsd-mavproxy.service  (Jetson host)
#
# TEMPLATE: __CRSD_USER__ / __CRSD_REPO__ are substituted by
# setup/install_jetson_host.sh at install time (invoking user + repo path).
# Do NOT `install` this file verbatim — the placeholders must be expanded.
# MAVProxy is the SOLE owner of the Pixhawk serial link. Everything else —
# ROS nodes, Mission Planner/QGC on the laptop, preflight — consumes its
# rebroadcast. Nothing may open /dev/crsd-pixhawk directly.
[Unit]
Description=Crusader MAVProxy (sole Pixhawk owner)
After=dev-crsd\x2dpixhawk.device network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__CRSD_USER__
# MAVProxy writes mav.tlog / mav.parm into its CWD. systemd's default CWD is /,
# which the service user cannot write — it errored on every start. StateDirectory
# creates /var/lib/crsd-mavproxy owned by User= on each start; telemetry logs land
# there (they are .gitignored and were never meant to sit in the repo).
StateDirectory=crsd-mavproxy
WorkingDirectory=/var/lib/crsd-mavproxy
# CRSD_BCAST_ADDR set in /etc/default/crusader (EnvironmentFile) so a change of
# field subnet doesn't require a unit edit. It is the SUBNET BROADCAST ADDRESS
# (e.g. 192.168.100.255), NOT a laptop IP — start_mavproxy.sh broadcasts, so
# every GCS on the field network sees the boat without anything being typed in.
# The variable used to be LAPTOP_IP, from when this was a unicast --out; putting
# a laptop's own address here now sends "broadcast" traffic to that one host.
# Unset is fine — the script falls back to its built-in default.
EnvironmentFile=-/etc/default/crusader
ExecStart=__CRSD_REPO__/scripts/start_mavproxy.sh ${CRSD_BCAST_ADDR}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
