# /etc/systemd/system/crsd-mavproxy.service  (Jetson host)
#
# TEMPLATE: __CRSD_USER__ / __CRSD_REPO__ are substituted by
# setup/install_jetson_host.sh at install time (invoking user + repo path).
# Do NOT `install` this file verbatim — the placeholders must be expanded.
# MAVProxy is the SOLE owner of the Pixhawk serial link. Everything else —
# ROS nodes, Mission Planner/QGC on the laptop, preflight, autoresearch —
# consumes its rebroadcast. Nothing may open /dev/crsd-pixhawk directly.
[Unit]
Description=Crusader MAVProxy (sole Pixhawk owner)
After=dev-crsd\x2dpixhawk.device network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__CRSD_USER__
# MAVProxy writes mav.tlog / mav.parm into its CWD. systemd's default CWD is /,
# which the service user cannot write — it errored on every start. StateDirectory
# creates /var/lib/crsd-mavproxy owned by User= on each start; telemetry logs land
# there (they are .gitignored and were never meant to sit in the repo).
StateDirectory=crsd-mavproxy
WorkingDirectory=/var/lib/crsd-mavproxy
# LAPTOP_IP set in /etc/default/crusader (EnvironmentFile) so field IP changes
# don't require a unit edit.
EnvironmentFile=-/etc/default/crusader
ExecStart=__CRSD_REPO__/scripts/start_mavproxy.sh ${LAPTOP_IP}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
