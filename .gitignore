# ============================================================
# rx26_asv .gitignore
# Rule of thumb: source and configs are tracked; anything a
# machine can regenerate (builds, caches, logs) is not.
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.python-version

# --- Test / tooling caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- colcon / ROS 2 workspace build artifacts (in-container builds) ---
build/
install/
log/

# --- ROS bags & MAVLink telemetry logs (archive out-of-repo) ---
# NOT *.param/*.params: the known-good ArduRover baseline in params/ is
# tracked on purpose — param_guard diffs against it before every arm.
*.bag
*.db3
*.mcap
*.tlog
*.tlog.raw
*.BIN

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Secrets ---
.env
*.key

# Operator-saved camera profiles, written by the ground station at runtime.
# The documented, reviewable profiles live in camera_profiles.yaml.
crusader_bringup/config/camera_profiles.local.yaml

# The Task 3 off-ROS sim: BehaviorTree.CPP fetched from source, and what
# tools/task3_sim/build.py compiles. Both are regenerated by build.py.
tools/task3_sim/.deps/
tools/task3_sim/.build/
