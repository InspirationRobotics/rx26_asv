# ============================================================
# rx26_asv .gitignore
# Rule of thumb: source and configs are tracked; anything a
# machine can regenerate (builds, caches, logs, engines) is not.
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.python-version

# --- Test / tooling caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- colcon / ROS 2 workspace build artifacts (in-container builds) ---
build/
install/
log/

# --- ROS bags & MAVLink telemetry logs (archive out-of-repo per plan §7) ---
*.bag
*.db3
*.mcap
*.tlog
*.parm
*.tlog.raw
*.BIN

# --- Per-Jetson TensorRT engines & model weights (regenerated per device,
#     see tools/training/train_buoy.py; the dataset lives outside the repo) ---
*.engine
*.onnx
*.pt
tools/training/runs/
tools/training/datasets/

# --- Generated protobuf classes (compiled from proto/ at build time) ---
*_pb2.py
*_pb2.pyi

# --- Episode / autoresearch run outputs (metrics JSON archived elsewhere) ---
# The orchestrator's own ignore rules live with it on `sim/orchestrator`.
*.episode.json

# --- Sim / orchestrator artifacts: never on main ---
# Nothing here generates these — they live on `sim/orchestrator`. But they are
# untracked build output, and untracked files survive a branch switch, so work
# done on that branch reappears here and `git add -A` would commit it. This
# guard is the reason that cannot happen. See docs/PARKED_SIM.md.
#
# Only untracked files are affected: if the branch is merged back, its tracked
# files land normally and these lines should be deleted.
tools/sim/worlds/
orchestrator/
docker/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Secrets ---
.env
*.key
