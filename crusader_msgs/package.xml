<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_msgs</name>
  <version>0.5.0</version>
  <description>
    Crusader message definitions: the typed contracts between packages.
    Depends on nothing but std_msgs, so any container can build it cheaply.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
