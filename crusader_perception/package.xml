<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_perception</name>
  <version>0.5.0</version>
  <description>
    camera_node (the OAK-D: buoy and dock models, the picture) and lidar_node (the
    MID360: clusters, the Nav2 cloud, proximity, the wall range). See the README.
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>crusader_msgs</depend>
  <depend>crusader_common</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- depthai and ultralytics are pip packages installed by the Dockerfile: no rosdep key -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
