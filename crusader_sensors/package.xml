<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_sensors</name>
  <version>0.5.0</version>
  <description>
    Device drivers that own hardware and publish its raw output as ROS topics.
    Builds with the rest of the stack (crusader_bringup exec_depends on it), but
    RUNS in the sensor container only: `asv` asserts depthai is absent by design.
    Holds `oakd_publisher` (OAK-D LR: RGB + depth aligned and paired on-device).
  </description>
  <maintainer email="brandont3927@gmail.com">Team Inspiration</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/InspirationRobotics/rx26_asv</url>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>crusader_msgs</depend>
  <depend>crusader_common</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- depthai has no rosdep key: it is a pip package supplied by the sensor
       container image, like the Livox SDK. Deliberately not listed as a rosdep
       dependency, so `rosdep install` in the asv container cannot pull the
       device SDK into the container that must not have it. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
