<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crusader_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic + ArduRover SITL simulation of Crusader and the RobotX
    2026 course. Sim only: nothing here runs on the boat.</description>
  <maintainer email="team@inspiration.invalid">Team Inspiration</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>crusader_msgs</exec_depend>
  <exec_depend>crusader_common</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
